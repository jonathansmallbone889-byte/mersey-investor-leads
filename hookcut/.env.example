# Claude: ranks clips and researches live trending hashtags. Without it, built-in scoring is used.
ANTHROPIC_API_KEY=
# Optional overrides
# HOOKCUT_MODEL=claude-opus-5-5
# WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 (bigger = more accurate, slower)
# WHISPER_DEVICE=auto          # auto | cpu | cuda
# HOOKCUT_MAX_MINUTES=180
# HOOKCUT_WORKERS=1
# YTDLP_COOKIES=/app/cookies.txt   # exported browser cookies if YouTube asks for a sign-in check
